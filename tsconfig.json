{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["node"],
    "strict": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
